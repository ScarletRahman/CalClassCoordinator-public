# Copy to .env (never commit it). On Fly.io set these with `fly secrets set NAME=value` instead.
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Public address of the site, no trailing slash. Used in email links.
APP_URL=https://classes.example.com
# docker compose only: the domain Caddy should serve.
SITE_ADDRESS=classes.example.com

# Email (verification, password reset, seat alerts). Any SMTP provider works.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<a Gmail app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CalClassCoordinator <you@example.com>"

# Encrypts saved plans and transcript class lists in the database. 32 random bytes, base64.
# Generate with:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe: without it saved plans cannot be read.
PLAN_ENCRYPTION_KEY=

# Shared secret between the web app and the watcher. Optional: one is generated at boot if unset.
WATCHER_API_TOKEN=

# Discord bot token (Developer Portal > your app > Bot). Leave empty to run without the bot.
DISCORD_BOT_TOKEN=
