# Planner web app configuration. Copy to .env.local for `npm run dev`; in production set these
# in the container's environment. Never commit real secrets.

# Public base URL of the site, used to build links in emails (verify, password reset).
# Also accepted as a trusted Origin for API requests. No trailing slash needed.
APP_URL=http://localhost:3000

# SQLite file for accounts, sessions, saved plans, email tokens and seat alerts.
# Put it on a persistent volume in production. Default: web/.data/planner.db
DATABASE_PATH=

# Folder with the generated data (courses.json, requirements/, seats/, ...). Default: ../data
# Missing files fall back to web/stub-data/.
CCC_DATA_DIR=

# Seat watcher HTTP API (python -m watcher serve). Used for live seats (GET /seats) and to
# forward seat alert sign-ups (POST/DELETE /subscriptions). Unset: seats come from
# $CCC_DATA_DIR/seats/latest.json and alerts are only stored in the database.
WATCHER_URL=
# Shared secret sent as "Authorization: Bearer <token>" on every watcher call. Must match the watcher.
WATCHER_API_TOKEN=

# Outgoing email (verification and password reset). If SMTP_HOST is unset nothing is sent:
# in development the link is printed to the server console; in production a warning is logged.
SMTP_HOST=
# 587 = STARTTLS required, 465 = implicit TLS, anything else = STARTTLS if offered.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address, e.g. "CalClassCoordinator <no-reply@example.org>". Default: SMTP_USER.
MAIL_FROM=

# Optional. Encrypts saved plans at rest with AES-256-GCM. 32 random bytes as base64 or 64 hex
# characters, e.g. `openssl rand -base64 32`. Existing plaintext rows are still read and get
# encrypted the next time they are saved. Keep it safe: losing it makes saved plans unreadable.
PLAN_ENCRYPTION_KEY=
